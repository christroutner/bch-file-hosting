# Copy to .env and fill in the required values.

# development | test | production
SVC_ENV=development
PORT=5050
# Base URL used to build downloadUrl in API responses
PUBLIC_URL=http://localhost:5050
LOG_LEVEL=info
LOG_DIR=./logs

# --- Wallet (required) ---
# 12-word mnemonic for the server HD wallet. Invoice addresses are derived from it.
MNEMONIC=
# Address that receives swept invoice payments
TREASURY_ADDRESS=
# web3 (free-bch.fullstack.cash consumer API) | web2 (bch.fullstack.cash REST) | x402
WALLET_INTERFACE=web3
# Override the BCH backend URL for the selected interface
APISERVER=
# WIF that pays for backend calls when WALLET_INTERFACE=x402
WALLET_WIF_X402=

# --- Pricing ---
USD_PER_MB_YEAR=0.01
# Files smaller than this are billed as this many bytes
MIN_BILLED_BYTES=100000
# Smallest invoice; keeps payments above the dust limit and sweep fees
MIN_INVOICE_SATS=2000
UNDERPAY_TOLERANCE_SATS=100
# How long a quote is valid; unpaid uploads are deleted after this window
QUOTE_TTL_HOURS=24

# --- Uploads and storage ---
MAX_FILE_SIZE_BYTES=100000000
UPLOAD_TMP_DIR=./tmp/uploads
LEVEL_DB_PATH=./.leveldb

# --- IPFS ---
IPFS_DIR=./.ipfsdata
IPFS_TCP_PORT=4001
IPFS_WS_PORT=4003
ENABLE_CIRCUIT_RELAY=false
# Set to true to skip joining the PSF network via helia-coord (useful offline)
DISABLE_IPFS_COORD=false
COORD_NAME=bch-file-hosting
# Comma-separated gateway prefixes; the CID is appended
PUBLIC_GATEWAYS=https://ipfs.io/ipfs/,https://dweb.link/ipfs/
# Comma-separated third-party pinning providers (e.g. lighthouse, added in phase 5)
PINNING_PROVIDERS=

# --- Access control ---
# Required for /admin routes; admin routes return 503 when unset
ADMIN_API_KEY=
RATE_LIMIT_PER_MIN=30
# Set to true behind a reverse proxy (nginx, Caddy) so rate limits see the client IP
TRUST_PROXY=false
