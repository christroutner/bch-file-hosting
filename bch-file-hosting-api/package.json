{
  "name": "bch-file-hosting-api",
  "version": "0.1.0",
  "description": "REST API that hosts files on IPFS in exchange for BCH",
  "main": "bin/server.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/server.js",
    "test": "SVC_ENV=test c8 mocha --recursive 'test/unit/**/*.unit.js'",
    "lint": "standard --env mocha --fix",
    "coverage": "SVC_ENV=test c8 --reporter=html --reporter=text mocha --recursive 'test/unit/**/*.unit.js'"
  },
  "author": "Chris Troutner <chris.troutner@gmail.com>",
  "license": "MIT",
  "c8": {
    "include": [
      "src/**",
      "config/**"
    ],
    "reporter": [
      "text"
    ]
  },
  "dependencies": {
    "dotenv": "18.0.6"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "chai": "6.3.0",
    "mocha": "12.0.3",
    "sinon": "22.1.0",
    "standard": "17.1.2"
  }
}
