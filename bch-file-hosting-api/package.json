{
  "name": "bch-file-hosting-api",
  "version": "0.1.0",
  "description": "REST API that hosts files on IPFS in exchange for BCH",
  "main": "bin/server.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/server.js",
    "test": "SVC_ENV=test c8 mocha --recursive 'test/unit/**/*.unit.js'",
    "test:integration": "node test/integration/host-file.js",
    "lint": "standard --env mocha --fix",
    "crap": "crap4javascript",
    "dry": "dry4javascript src",
    "mutate": "mutate4javascript",
    "coverage": "SVC_ENV=test c8 --reporter=html --reporter=text mocha --recursive 'test/unit/**/*.unit.js'"
  },
  "author": "Chris Troutner <chris.troutner@gmail.com>",
  "license": "MIT",
  "overrides": {
    "@multiformats/multiaddr-to-uri": "10.1.2",
    "@multiformats/multiaddr-matcher": "1.6.0",
    "@libp2p/utils": "6.7.1",
    "helia": {
      "libp2p": "2.7.2",
      "@libp2p/upnp-nat": "3.0.0"
    }
  },
  "c8": {
    "include": [
      "bin/**",
      "src/**",
      "config/**"
    ],
    "reporter": [
      "text"
    ]
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "helia-coord": "2.0.3",
    "level": "10.0.0",
    "minimal-slp-wallet": "7.1.5",
    "multer": "2.4.0",
    "multiformats": "13.4.2",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "chai": "6.3.0",
    "crap4javascript": "github:FullStack-Agents/crap4javascript",
    "dry4javascript": "github:FullStack-Agents/dry4javascript",
    "memory-level": "3.1.0",
    "mocha": "12.0.3",
    "mutate4javascript": "github:FullStack-Agents/mutate4javascript",
    "sinon": "22.1.0",
    "standard": "17.1.2",
    "supertest": "7.3.1"
  }
}
