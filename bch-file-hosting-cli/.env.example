# Environment variables for bch-file-hosting-cli.
# Copy this file to .env and adjust as needed.

# Base URL of the bch-file-hosting REST API.
HOSTING_API_URL=http://localhost:5050

# BCH backend used by the local minimal-slp-wallet.
WALLET_URL=https://free-bch.fullstack.cash
# consumer-api = web3 Cash Stack, rest-api = web2 Cash Stack.
WALLET_INTERFACE=consumer-api
